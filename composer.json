{
    "name": "svenpetersen/ux-driver",
    "description": "Product tours with driver.js for Symfony UX, with the seen state stored per user",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony-ux",
        "driver.js",
        "product-tour",
        "onboarding"
    ],
    "authors": [
        {
            "name": "Sven Petersen"
        }
    ],
    "autoload": {
        "psr-4": {
            "SvenPetersen\\UX\\Driver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SvenPetersen\\UX\\Driver\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/security-csrf": "^8.0",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/twig-bundle": "^8.0",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "symfony/asset-mapper": "^8.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0"
    },
    "suggest": {
        "symfony/asset-mapper": "To load the Stimulus controller through AssetMapper instead of Webpack Encore"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
